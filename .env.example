# ============================================================================
# ParcInfo — Docker Environment Configuration
# ============================================================================
#
# INSTRUCTIONS:
# 1. Copier ce fichier en ".env" dans le répertoire du projet
# 2. Adapter les valeurs selon votre environnement
# 3. Référencer via: docker-compose -f docker-compose.yml --env-file .env up
#
# NOTE IMPORTANTE : cette liste n'est PAS un panneau de configuration général
# de ParcInfo. Les seules variables ci-dessous sont celles que le code lit
# réellement (`os.environ.get(...)`, vérifié dans app.py/database.py). Tous
# les autres réglages (thème, pagination, rate-limiting, cache, compression,
# recherche, rétention de l'historique, chiffrement des identifiants...) se
# configurent DANS l'application, écran Réglages — ils sont persistés dans la
# base (table `configurations`), pas via des variables d'environnement.
# Positionner une variable qui ne figure pas ci-dessous n'aura aucun effet.
#
# Ce fichier est OPTIONNEL — les valeurs par défaut de docker-compose.yml
# s'appliquent en son absence.

# ============================================================================
# SYSTÈME
# ============================================================================

# Marque le conteneur comme environnement Docker (chemin data, comportements
# de démarrage adaptés). Déjà positionné dans docker-compose.yml — ne pas
# retirer si vous partez de ce fichier.
RUNNING_IN_DOCKER=1

# Dossier où vivent parc_info.db, secret.key, uploads/, oui.txt... à faire
# pointer sur le volume monté (voir docker-compose.yml : /data).
DATA_DIR=/data

# Timezone du conteneur (affecte les horodatages dans les logs et l'historique)
TZ=Europe/Paris

# Buffering stdout (1 = ligne par ligne ; important pour voir les logs en
# direct avec `docker logs -f`). Lu par l'interpréteur Python lui-même, pas
# par ParcInfo.
PYTHONUNBUFFERED=1

# Mode debug Flask — rechargement auto + tracebacks détaillés dans le
# navigateur. JAMAIS en production (fuite d'informations internes).
FLASK_DEBUG=0

# ============================================================================
# SAUVEGARDE & SYNCHRONISATION
# ============================================================================

# Désactive la sauvegarde automatique de la base (par défaut activée).
# PARCINFO_BACKUP=0

# Désactive la synchronisation Turso multi-instance même si elle est
# configurée dans Réglages → Collecteur & sauvegardes (dépannage).
# DISABLE_TURSO_SYNC=1

# ============================================================================
# UPLOADS
# ============================================================================

# Taille max d'un fichier uploadé, en Mo (défaut : 64). Le nom de cette
# variable est spécifique à ParcInfo — ce n'est pas un réglage Flask standard.
# PARCINFO_MAX_UPLOAD_MB=64

# ============================================================================
# NOTES IMPORTANTES
# ============================================================================
#
# 1. Ce fichier est OPTIONNEL — les valeurs par défaut s'appliquent sinon
#
# 2. Ne pas commettre .env en Git (déjà dans .gitignore)
#
# 3. Pour appliquer des changements :
#    docker-compose down && docker-compose up -d
#
# 4. Pour les profils de ressources (CPU/RAM) selon la puissance du NAS,
#    voir docker-compose.synology.yml (standard), -light.yml et -heavy.yml —
#    ce sont des limites Docker, pas des variables lues par l'application.
#
# 5. Format : KEY=value (pas de guillemets sauf si la valeur contient des
#    espaces)
#
# ============================================================================
